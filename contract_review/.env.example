# Copy to contract_review/.env and fill in values. Never commit .env.

GOOGLE_API_KEY=replace_with_your_key

# Preferred Gemini model for review agents (override after a successful smoke).
REVIEW_MODEL=gemini-flash-latest

# Optional: comma-separated fallback models when the preferred model is exhausted.
# REVIEW_MODELS=gemini-flash-latest,gemini-2.0-flash

# Optional judge model for evaluation only.
# REVIEW_JUDGE_MODEL=gemini-pro-latest
